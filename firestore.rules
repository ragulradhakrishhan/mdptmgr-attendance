rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || myRole() in ['staff', 'admin']);
      allow write: if request.auth != null && myRole() == 'admin';
    }

    match /attendance/{id} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || myRole() in ['staff', 'admin']);
      allow write: if request.auth != null && myRole() in ['staff', 'admin'];
    }

    match /contacts/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && myRole() == 'admin';
    }
  }
}
